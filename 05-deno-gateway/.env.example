# HTTP server configuration
PORT=6910

# AES-256 encryption key for encrypted Deno KV configuration.
# Generate a new value with:
# openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Deno KV configuration.
# Leave these empty when using local Deno KV.
# Use the provider-specific values when using remote Deno KV.
DENO_KV_URL=
DENO_KV_ACCESS_TOKEN=

# Optional local Deno KV database path.
DENO_KV_PATH=/data/gateway.sqlite3
