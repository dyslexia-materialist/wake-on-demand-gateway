{
  "name": "@wake-on-demand/deno-gateway",
  "version": "0.1.0",
  "description": "Authenticated Wake-on-Demand gateway for sleeping Linux servers",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read=./static src/main.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read=./static src/main.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check src/main.ts",
    "test": "deno test --allow-env"
  },
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.1.0",
    "md5": "npm:md5@^2.3.0"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
